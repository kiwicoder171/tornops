{
  "name": "torn-faction-suite",
  "private": true,
  "scripts": {
    "postinstall": "pnpm --filter @torn/db db:generate",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push"
  },
  "devDependencies": {
    "prisma": "^6.4.1",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "prisma": {
    "schema": "packages/db/prisma/schema.prisma"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@prisma/client"
    ]
  },
  "packageManager": "pnpm@12.10.1"
}
